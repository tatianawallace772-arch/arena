# ─────────────────────────────────────────────────────────────
#  Arena Code Agent — configuration
#  Copy to .env  (cp .env.example .env)
# ─────────────────────────────────────────────────────────────

# Inception Labs API (Mercury). Get a key at https://inceptionlabs.ai
INCEPTION_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1

# Model used for the agent loop.
#   mercury-3       — current flagship: 1M context, native tool calling (default)
#   mercury-2.5     — previous generation, 260K context
#   mercury-2       — earlier reasoning model, 128K context
# The UI pulls the live list from GET /v1/models, so any model your key can
# use will show up in the model menu.
INCEPTION_MODEL=mercury-3

# Inception requires temperature between 0.5 and 1.0 (0.7 is a good default).
INCEPTION_TEMPERATURE=0.7

# Max output tokens per step.
INCEPTION_MAX_TOKENS=16384

# Reasoning effort: instant | low | medium | high
INCEPTION_REASONING_EFFORT=medium

# Web server
PORT=3000
HOST=0.0.0.0

# Root directory the agent is allowed to read/write and run commands in.
# Defaults to this repository. Traversal outside it is blocked.
WORKSPACE_ROOT=

# Optional shared secret. If set, the browser must supply it to connect.
# Leave empty for local-only use.
AGENT_TOKEN=
