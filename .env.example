# ---------------------------------------------------------------------------
# arena configuration.  Copy to `.env` and fill in your own keys:
#
#     cp .env.example .env
#
# `.env` is git-ignored on purpose — never commit real credentials, and rotate
# any key that has ever been pasted into chat, an issue, or a screenshot.
# Keys are read by the server process only; the browser never sees them.
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
PORT=3000
# 0.0.0.0 so the app is reachable through a preview/reverse-proxy host.
HOST=0.0.0.0

# --- stealth/ox-alpha  ->  OpenRouter ---------------------------------------
# Get a key at https://openrouter.ai/settings/keys  (format: sk-or-v1-...)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter model slug, e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: attribution shown on openrouter.ai rankings.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=arena / stealth-ox-alpha

# --- big-pickle  ->  OpenCode Zen -------------------------------------------
# Get a key at https://opencode.ai/zen  (format: sk-...)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# Any Zen model id, e.g. opencode/gpt-5-nano, deepseek-v4-flash, kimi-k2.6
OPENCODE_MODEL=opencode/gpt-5-nano

# --- limits -----------------------------------------------------------------
UPSTREAM_TIMEOUT_MS=60000
MAX_BODY_BYTES=262144
MAX_MESSAGES=64
