{
  "name": "scratch-blockly-app-maker",
  "private": true,
  "version": "1.0.0",
  "description": "Scratch-inspired visual App & Game Maker powered by Google Blockly (Zelos renderer)",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@blockly/continuous-toolbox": "^13.5.0",
    "@blockly/field-angle": "^13.5.0",
    "@blockly/field-colour": "^13.5.0",
    "@blockly/field-slider": "^13.5.0",
    "@fontsource-variable/fredoka": "^5.1.1",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "blockly": "^13.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
